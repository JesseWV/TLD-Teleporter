<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>Latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <DebugType>none</DebugType>
    <AssemblyName>Teleporter</AssemblyName>
    <RootNamespace>Teleporter</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MonsieurMeh.Modding.TLD.Il2CppAssemblies.Windows" Version="2.58.0" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="ModSettings">
      <HintPath>$(MSBuildProjectDirectory)\lib\ModSettings.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Using Include="System.Reflection" />
    <Using Include="Il2Cpp" />
    <Using Include="HarmonyLib" />
    <Using Include="MelonLoader" />
    <Using Include="UnityEngine" />
    <Using Include="ModSettings" />
  </ItemGroup>

</Project>
